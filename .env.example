# Copy to .env next to SKILL.md. Values here override system environment variables.
IMAGE_PROVIDER=gemini

# Gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://your-gemini-endpoint.example
# GEMINI_MODEL=gemini-3-pro-image-preview
# GEMINI_GOOGLE_SEARCH=false

# GPT Image
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-openai-endpoint.example/v1
# OPENAI_MODEL=gpt-image-2

# Qwen Image (DashScope)
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Use a key matching the endpoint region. Example workspace endpoints:
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
# QWEN_MODEL=qwen-image-3.0
# Service-side prompt rewriting, disabled by default
# QWEN_PROMPT_EXTEND=false
