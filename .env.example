# Gemini Image Generator Configuration
# Copy this file to .env and fill in your values
#
# Priority: .env > system environment variables > default values

# ===== Provider Selection =====
# Image generation provider: gemini or gpt (default: gemini)
IMAGE_PROVIDER=gemini

# ===== Gemini Configuration =====
# Your Gemini API key (required when IMAGE_PROVIDER=gemini)
GEMINI_API_KEY=your_api_key_here

# Custom base URL for Gemini API endpoint (optional)
# GEMINI_BASE_URL=https://custom.endpoint.com

# Model name for Gemini image generation (optional)
# Default: gemini-3-pro-image-preview
# GEMINI_MODEL=gemini-3-pro-image-preview

# ===== OpenAI/GPT Configuration =====
# Your OpenAI API key (required when IMAGE_PROVIDER=gpt)
OPENAI_API_KEY=your_openai_api_key_here

# Custom base URL for OpenAI API endpoint (optional, for proxy or alternative endpoints)
# OPENAI_BASE_URL=https://your-proxy-url.com

# OpenAI image generation model (optional)
# Default: gpt-image-2
# OPENAI_MODEL=gpt-image-2
