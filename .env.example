# Gemini Image Generator Configuration
# Copy this file to .env and fill in your values
#
# Priority: .env > system environment variables > default values

# ===== Provider Selection =====
# Image generation provider: gemini | gpt | qwen (default: gemini)
IMAGE_PROVIDER=gemini

# ===== Prompt Conversion =====
# Whether to convert JSON prompt to natural language: true or false (default: true)
# When false, raw user_intent text is used directly without JSON conversion
JSON_TO_PROMPT=true

# ===== Gemini Configuration =====
# Your Gemini API key (required when IMAGE_PROVIDER=gemini)
GEMINI_API_KEY=your_api_key_here

# Custom base URL for Gemini API endpoint (optional)
# GEMINI_BASE_URL=https://custom.endpoint.com

# Model name for Gemini image generation (optional)
# Default: gemini-3-pro-image-preview
# GEMINI_MODEL=gemini-3-pro-image-preview

# ===== OpenAI/GPT Configuration =====
# Your OpenAI API key (required when IMAGE_PROVIDER=gpt)
OPENAI_API_KEY=your_openai_api_key_here

# Custom base URL for OpenAI API endpoint (optional, for proxy or alternative endpoints)
# OPENAI_BASE_URL=https://your-proxy-url.com

# OpenAI image generation model (optional)
# Default: gpt-image-2
# OPENAI_MODEL=gpt-image-2

# ===== Qwen / DashScope Configuration =====
# Required when IMAGE_PROVIDER=qwen
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Custom endpoint (optional). Default: standard DashScope endpoint.
# NOTE: Beijing and Singapore regions use SEPARATE API keys and endpoints that
# are NOT interchangeable. For workspace-specific domains, use for example:
#   Beijing:    https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
#   Singapore:  https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Model name (optional). Default: qwen-image-3.0
# Use qwen-image-3.0-pro for higher quality (supports T2I and I2I, 1-3 reference images).
# QWEN_MODEL=qwen-image-3.0

# Enable qwen built-in prompt rewriting (optional, default false).
# The skill already expands the prompt via JSON->NL conversion; enable only if
# you want qwen's additional rewriting on top.
# QWEN_PROMPT_EXTEND=false
